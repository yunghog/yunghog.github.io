# Admin login. Use a password of 12+ characters. Prefer ADMIN_PASSWORD_HASH for production.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-long-random-password
# Optional bcrypt hash alternative; if set, this takes precedence over ADMIN_PASSWORD.
ADMIN_PASSWORD_HASH=
SESSION_SECRET=replace-with-at-least-32-random-characters

# Firebase Admin SDK server credentials. Never expose these to browser JavaScript.
# Option A: path to downloaded service-account JSON file outside the public/ folder.
GOOGLE_APPLICATION_CREDENTIALS=./secrets/firebase-service-account.json
# Option B: set FIREBASE_SERVICE_ACCOUNT_JSON to the complete JSON string instead.
FIREBASE_SERVICE_ACCOUNT_JSON=
FIREBASE_DATABASE_URL=https://YOUR-PROJECT-default-rtdb.firebaseio.com

# Firebase web config used only for Analytics; these are public app identifiers, not admin secrets.
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
FIREBASE_MEASUREMENT_ID=
FIREBASE_MESSAGING_SENDER_ID=
# Firebase Console > Project settings > Cloud Messaging > Web Push certificates (VAPID key)
FIREBASE_VAPID_KEY=

NODE_ENV=development
PORT=3000
TRUST_PROXY=false
IP_HASH_SALT=replace-with-an-independent-random-salt
